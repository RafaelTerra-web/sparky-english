NEXT_PUBLIC_SITE_URL=http://localhost:3200
# OAuth Web client from Google Cloud. This is a public identifier, not a secret.
SPARKY_GOOGLE_CLIENT_ID=
# Generate at least 32 random bytes. Never commit the real value.
SPARKY_SESSION_SECRET=
# Exact invited Google emails, comma separated. Empty means deny everyone.
SPARKY_ALLOWED_EMAILS=
SPARKY_ADDITIONAL_ALLOWED_EMAILS=Tenterra@gmail.com,Ni.pecanha@gmail.com
# Optional further invitations; combines with both existing lists.
SPARKY_INVITED_EMAILS=
# Enable only after the onboarding migration and private audio provisioning.
SPARKY_ONBOARDING_ENABLED=false
GEMINI_API_KEY=
GEMINI_TTS_PROVIDER=vertex
CRON_SECRET=
# Voice practice UI; set false to disable. Playback uses pre-generated audio.
NEXT_PUBLIC_VOICE_ENABLED=true
# Server-side persistence uses the existing verified Google session identity.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Enable only after applying 20260905000100_durable_google_progress.sql.
# Never expose the service-role key in NEXT_PUBLIC variables.
SPARKY_DURABLE_PROGRESS=false
# Productive assessment uses the exact models in assessment-provider.ts.
# Missing credentials leave the assessment unavailable, never passed/failed.
OPENAI_API_KEY=

# Conversational Call (server-only Alibaba Cloud Model Studio, Singapore).
# Enable only after the database migration and Qwen smoke test pass.
NEXT_PUBLIC_SPARKY_CALL_ENABLED=false
# Create a pay-as-you-go key; never expose it through NEXT_PUBLIC_*.
DASHSCOPE_API_KEY=
# Recommended dedicated workspace domain. The legacy international domain is
# used when this is empty.
DASHSCOPE_WORKSPACE_ID=
QWEN_HTTP_BASE_URL=
QWEN_WEBSOCKET_BASE_URL=
QWEN_TTS_SPARKY_VOICE=Ethan
QWEN_TTS_PINKY_VOICE=Cherry
# Active Call transcripts are retained for resume; after End they are scrubbed
# unless this is deliberately enabled and the privacy policy/consent are updated.
SPARKY_CALL_STORE_TRANSCRIPTS=false
# Local development only; it is ignored in Production.
SPARKY_CALL_MOCK=false

# Optional secret for administrative, fixed-curriculum audio preparation only.
SPARKY_AUDIO_ADMIN_TOKEN=
