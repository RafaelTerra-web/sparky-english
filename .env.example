NEXT_PUBLIC_SITE_URL=http://localhost:3200
# OAuth Web client from Google Cloud. This is a public identifier, not a secret.
SPARKY_GOOGLE_CLIENT_ID=
# Generate at least 32 random bytes. Never commit the real value.
SPARKY_SESSION_SECRET=
# Exact invited Google emails, comma separated. Empty means deny everyone.
SPARKY_ALLOWED_EMAILS=
# Voice practice UI; set false to disable. Playback uses pre-generated audio.
NEXT_PUBLIC_VOICE_ENABLED=true
# Supabase is not connected to the current Google session implementation yet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Enable only after applying 20260905000100_durable_google_progress.sql.
# Never expose the service-role key in NEXT_PUBLIC variables.
SPARKY_DURABLE_PROGRESS=false
