{
  "a1-1-1": {
    "text": "Hi, I'm Ana.",
    "sparky": "/audio/mascots/f9434ec87835036f06487de40d50483e.wav",
    "pinky": "/audio/mascots/9c779f2f514336baf5672d42403a6a4c.wav"
  },
  "a1-identidade-01": {
    "text": "What is your name?",
    "sparky": "/audio/mascots/c2fbbdc2fc2a5ed9e2e8172f5ea9c7db.wav",
    "pinky": "/audio/mascots/19cd6b4488d69cc9e671ed8def571e24.wav"
  },
  "a1-identidade-02": {
    "text": "I am from Brazil.",
    "sparky": "/audio/mascots/a2f262c6e765f5b8e29d503d12166788.wav",
    "pinky": "/audio/mascots/5f861f35eccd808f77949f715138c17d.wav"
  },
  "a1-identidade-03": {
    "text": "I am twenty years old.",
    "pinky": "/audio/mascots/b95ace7f9c7530ce1e4a91cb52f00649.wav",
    "sparky": "/audio/mascots/98ecb8116985a6b121cffc884805228c.wav"
  },
  "a1-identidade-04": {
    "text": "This is my friend Clara.",
    "pinky": "/audio/mascots/c06095d44676b3b69f7f4379dee097f9.wav",
    "sparky": "/audio/mascots/4a6d94ee1f7b230f54cc473f216fa84f.wav"
  },
  "a1-identidade-05": {
    "text": "We are not late.",
    "sparky": "/audio/mascots/794b03bf296666b7146eea31948751a1.wav",
    "pinky": "/audio/mascots/074b26825147353a1a9aacc48011dc49.wav"
  },
  "a1-identidade-06": {
    "text": "How do you spell your surname?",
    "sparky": "/audio/mascots/2820473a82e25a1c0bb808366bed2f54.wav",
    "pinky": "/audio/mascots/5901d75cdcc081eac9604bcb4edc26f1.wav"
  },
  "a1-pessoas-01": {
    "text": "She is an engineer.",
    "pinky": "/audio/mascots/fa5f2f23349766bb3229254207ad83bf.wav",
    "sparky": "/audio/mascots/095ffcc0cc2de6be6057f7a9292b3420.wav"
  },
  "a1-pessoas-02": {
    "text": "There are two boxes here.",
    "pinky": "/audio/mascots/c91becd6f3dc7a117acc0bb864baa5a8.wav",
    "sparky": "/audio/mascots/e8ea9a47a5ca0564036e9350778c57a5.wav"
  },
  "a1-pessoas-03": {
    "text": "My sister has two children.",
    "sparky": "/audio/mascots/37a232b93963bb0697adcb93fcfb68e8.wav",
    "pinky": "/audio/mascots/f2c540ee9d29272caf9a1b1f83761cb7.wav"
  },
  "a1-pessoas-04": {
    "text": "This is Ana's bag.",
    "pinky": "/audio/mascots/9780dd2a9f6486c1b2573bdb814b5cff.wav",
    "sparky": "/audio/mascots/bbe4b79fbf8414fe90737c27059b3e08.wav"
  },
  "a1-pessoas-05": {
    "text": "These shoes are new.",
    "sparky": "/audio/mascots/7ce925bd261d6d3462268fe2e4b4e751.wav",
    "pinky": "/audio/mascots/c6c91d6008f8c4b83e7a3e1e675d71be.wav"
  },
  "a1-pessoas-06": {
    "text": "They have a small garden.",
    "sparky": "/audio/mascots/2627d49d62227319a1cdaafc69a091f8.wav",
    "pinky": "/audio/mascots/acbf2f3165a7d178a831fcd1995f1520.wav"
  },
  "a1-2-1": {
    "text": "I start work at nine.",
    "pinky": "/audio/mascots/e36784a29f78a361589311e588c17eb2.wav",
    "sparky": "/audio/mascots/d8ba1a990fd124c6dc9575473c476011.wav"
  },
  "a1-rotina-01": {
    "text": "She studies English every evening.",
    "sparky": "/audio/mascots/996d694b261f03ac0c5c1b2fe50be9ef.wav",
    "pinky": "/audio/mascots/434a6c556eafe5406021d5af4669e673.wav"
  },
  "a1-rotina-02": {
    "text": "I do not drink coffee.",
    "sparky": "/audio/mascots/b0ead4b7be52aa2b131fbb2cd1b426d9.wav",
    "pinky": "/audio/mascots/e1bca24d4f93f2ea755b2b67ef8f10db.wav"
  },
  "a1-rotina-03": {
    "text": "Do you work on Sundays?",
    "sparky": "/audio/mascots/51c3ada0abd128afebc29745ecd42b7c.wav",
    "pinky": "/audio/mascots/097cd5ba09767b19c0166ea3ef847d9b.wav"
  },
  "a1-rotina-04": {
    "text": "I usually walk to school.",
    "sparky": "/audio/mascots/1b6829ca71a0fbf15acc1a5e7e098d7e.wav",
    "pinky": "/audio/mascots/cb4b87e41f284c3508bea445390f59f0.wav"
  },
  "a1-rotina-05": {
    "text": "The lesson starts at half past six.",
    "pinky": "/audio/mascots/90fb524cf76edb6c993237c5913c9ca8.wav",
    "sparky": "/audio/mascots/34c7159d7a19a1626dca859c4f3933cc.wav"
  },
  "a1-rotina-06": {
    "text": "My birthday is in October.",
    "sparky": "/audio/mascots/c931bda146100f5f01d2c4b7d454d6c8.wav",
    "pinky": "/audio/mascots/72e1504de17f5af3c768e2c3fe4d4960.wav"
  },
  "a1-casa-01": {
    "text": "There is a library near my home.",
    "sparky": "/audio/mascots/e95868fea5ded94dd65177303002f57f.wav",
    "pinky": "/audio/mascots/9aea85ef3d1af5e8914f7c1427d28e7e.wav"
  },
  "a1-casa-02": {
    "text": "The keys are under the chair.",
    "sparky": "/audio/mascots/6f5dfb766894da0d511c742e01e14bbf.wav",
    "pinky": "/audio/mascots/1ea11ac79eebd921611f9fa51c87ffe6.wav"
  },
  "a1-casa-03": {
    "text": "The kitchen is small but bright.",
    "sparky": "/audio/mascots/3e2b94f69da070473d30d6f88335d386.wav",
    "pinky": "/audio/mascots/52ac5a55588a5f910ecd18445d3773e1.wav"
  },
  "a1-casa-04": {
    "text": "Turn left at the bank.",
    "sparky": "/audio/mascots/32e76af0077e8a61aba22b9da713599c.wav",
    "pinky": "/audio/mascots/5bc2cbb002d7a74babc912275a5f297a.wav"
  },
  "a1-casa-05": {
    "text": "I go to college by train.",
    "sparky": "/audio/mascots/db4178213b474f40955b35d157148305.wav",
    "pinky": "/audio/mascots/ed972bda62ce6383480c16522fbf1863.wav"
  },
  "a1-casa-06": {
    "text": "Please keep the door closed.",
    "sparky": "/audio/mascots/1f10b54cf954c266b67b25cb2f764cfb.wav",
    "pinky": "/audio/mascots/ae4dead1a0394b43a84e8fd229412632.wav"
  },
  "a1-consumo-01": {
    "text": "I would like a sandwich, please.",
    "sparky": "/audio/mascots/3247e2c455d7cc0b383e76761ea09fe1.wav",
    "pinky": "/audio/mascots/a7ec4e4adc3523e65c276c2ff2909a0f.wav"
  },
  "a1-consumo-02": {
    "text": "I like cooking with my friends.",
    "sparky": "/audio/mascots/f84588c9e323c7ef710f9b79bc1c43f0.wav",
    "pinky": "/audio/mascots/d35dbc57239936debf090af104325cc2.wav"
  },
  "a1-consumo-03": {
    "text": "We need two bottles of water.",
    "pinky": "/audio/mascots/8bf11e1f7ded067cae358fbf5516f43e.wav",
    "sparky": "/audio/mascots/4b0ecf18371c02b8fa2ffb295bdcbdf5.wav"
  },
  "a1-consumo-04": {
    "text": "There is some milk in the fridge.",
    "sparky": "/audio/mascots/5313bc20055ed2e6c12aec69abd7d039.wav",
    "pinky": "/audio/mascots/0300b45b116cf0f9d1075b14774922e4.wav"
  },
  "a1-consumo-05": {
    "text": "How much is this blue shirt?",
    "sparky": "/audio/mascots/261ddc405cdb4fc05c10f127e35619b6.wav",
    "pinky": "/audio/mascots/b222813790f496f3d82b6fffed318a52.wav"
  },
  "a1-consumo-06": {
    "text": "This jacket is too small.",
    "sparky": "/audio/mascots/8f56a9c05f1a005f5590860126f1ed60.wav",
    "pinky": "/audio/mascots/80ed549e194bfc5e9d29c6770ccb7d00.wav"
  },
  "a1-interacao-01": {
    "text": "My brother can play the guitar.",
    "sparky": "/audio/mascots/66e6900af6e28a25080a4d0c42621b40.wav",
    "pinky": "/audio/mascots/7e0bd34b78096e3940fb6c3bd0d37f43.wav"
  },
  "a1-interacao-02": {
    "text": "Can I open the window?",
    "pinky": "/audio/mascots/48c703ebe197eb2e2ab55438a8890b9d.wav",
    "sparky": "/audio/mascots/4149c3fc61b5ddec8b05d1a991b75f03.wav"
  },
  "a1-interacao-03": {
    "text": "They are waiting for the bus.",
    "pinky": "/audio/mascots/d773fe0c593b3418be61c341c03389b8.wav",
    "sparky": "/audio/mascots/0f6fed1fbdffdc90606b0019f9dc627d.wav"
  },
  "a1-interacao-04": {
    "text": "Are you listening to the teacher?",
    "sparky": "/audio/mascots/c11507bd64354e6664b12995035e5a2a.wav",
    "pinky": "/audio/mascots/6fa2856dfa1c3bc3cdcef5e807dee2d1.wav"
  },
  "a1-interacao-05": {
    "text": "It is cold and windy today.",
    "sparky": "/audio/mascots/156a746b179d1dcb8bbea3bccbe9518d.wav",
    "pinky": "/audio/mascots/97be7eb15cd9880eb26a996821148a59.wav"
  },
  "a1-interacao-06": {
    "text": "See you at the library at four.",
    "sparky": "/audio/mascots/0d84d8920958356b26e00091b3e69cc5.wav",
    "pinky": "/audio/mascots/5d5a4ec153234587a0abd2c7f8c94391.wav"
  },
  "a2-passado-01": {
    "text": "We were at home last night.",
    "sparky": "/audio/mascots/e1895bc52b29deca6c0bec6d7c42b1fd.wav",
    "pinky": "/audio/mascots/f2319c3d365653d2991630b99e0738dd.wav"
  },
  "a2-passado-02": {
    "text": "She visited her aunt last weekend.",
    "sparky": "/audio/mascots/0ac4eed0d208f1423b82ea1d1979dec2.wav",
    "pinky": "/audio/mascots/9f87225fc764a7512ed7f0305659d230.wav"
  },
  "a2-passado-03": {
    "text": "We bought fresh fruit at the market.",
    "pinky": "/audio/mascots/26ffd53458231a05f1da7daa685e64bd.wav",
    "sparky": "/audio/mascots/33ce5621b1402f140fd065e3b50e3ebf.wav"
  },
  "a2-4-1": {
    "text": "I went to the park yesterday.",
    "sparky": "/audio/mascots/fb26174cd847e2859e5228b107da5e5f.wav",
    "pinky": "/audio/mascots/86d72748e5f486ba2d316453066bb9c5.wav"
  },
  "a2-passado-04": {
    "text": "They did not travel last month.",
    "sparky": "/audio/mascots/008912b12605591f2d3fc002815aa36e.wav",
    "pinky": "/audio/mascots/4464fb555f2da02a448e4daebd743377.wav"
  },
  "a2-passado-05": {
    "text": "First we ate, then we visited the museum.",
    "sparky": "/audio/mascots/30903af38ddd1d706575d9e53a4b1eb2.wav",
    "pinky": "/audio/mascots/5a8e1185904e5dd80d72e615f90f638c.wav"
  },
  "a2-passado-06": {
    "text": "I was studying when the phone rang.",
    "pinky": "/audio/mascots/2ac5bb45c92b6e0a37f70a5f91b72680.wav",
    "sparky": "/audio/mascots/955a414960aa8e3eeb267deb5bf90162.wav"
  },
  "a2-escolhas-01": {
    "text": "This train is cheaper than the bus.",
    "sparky": "/audio/mascots/805e1d4ea004340abf0da32099658722.wav",
    "pinky": "/audio/mascots/0be02469c3a1a45d4bcf93759e39a980.wav"
  },
  "a2-escolhas-02": {
    "text": "This is the quietest room in the hotel.",
    "sparky": "/audio/mascots/fbaf66ae2f7fb034af05782d8afe37e0.wav",
    "pinky": "/audio/mascots/30554590b13f9489f19fd95f62945717.wav"
  },
  "a2-escolhas-03": {
    "text": "The bus is not as fast as the train.",
    "sparky": "/audio/mascots/080859c7e206897c3246246fbc8bc628.wav",
    "pinky": "/audio/mascots/b246c44e5eb89ae153755ecc93a90ae2.wav"
  },
  "a2-escolhas-04": {
    "text": "This bag is too heavy to carry.",
    "sparky": "/audio/mascots/62eb4e9973e0af216e49465aa361d321.wav",
    "pinky": "/audio/mascots/734b0ae045a0678df429400a73b63632.wav"
  },
  "a2-escolhas-05": {
    "text": "We do not have much time.",
    "pinky": "/audio/mascots/3dc3b880afabf55f4e7ebf92cedbbfe6.wav",
    "sparky": "/audio/mascots/470f55f78beda1f4f821095b5d0ad1c2.wav"
  },
  "a2-escolhas-06": {
    "text": "We have a few minutes before the class.",
    "sparky": "/audio/mascots/14623dd50c2a9075d11b74ca16c2736d.wav",
    "pinky": "/audio/mascots/519b5e1443d14da165154281ae7183d6.wav"
  },
  "a2-experiencias-01": {
    "text": "I have visited three different countries.",
    "pinky": "/audio/mascots/5cd78bf3335521946a83a05d5d1e94d9.wav",
    "sparky": "/audio/mascots/34bf9ecf2b9aa04aebfed08f9d10c053.wav"
  },
  "a2-experiencias-02": {
    "text": "Have you ever tried Korean food?",
    "sparky": "/audio/mascots/34b302d484edec9a400283c4c53e9e6e.wav",
    "pinky": "/audio/mascots/6fab7882da703599e52e7da9295b1cd9.wav"
  },
  "a2-experiencias-03": {
    "text": "I have just finished my homework.",
    "sparky": "/audio/mascots/904b6dba268380d029ddfebe94c416d9.wav",
    "pinky": "/audio/mascots/f4b68142075d3c61c260388dbe344cf1.wav"
  },
  "a2-experiencias-04": {
    "text": "She has lived here since 2020.",
    "pinky": "/audio/mascots/24f9476d77cb32ed8a6b663464a7d851.wav",
    "sparky": "/audio/mascots/c54c5df35e9e7d763cb5c145095c1536.wav"
  },
  "a2-experiencias-05": {
    "text": "Lia has gone to the supermarket.",
    "sparky": "/audio/mascots/d9530e15b90848de73bb5df41b9d14c7.wav",
    "pinky": "/audio/mascots/2dd5db69d1614ef89b89562e822f7928.wav"
  },
  "a2-experiencias-06": {
    "text": "I saw that film last Friday.",
    "sparky": "/audio/mascots/b752fd5dd3d9d7541dee0612ff2c9599.wav",
    "pinky": "/audio/mascots/0ed18a544027d40a555f2254e625ba68.wav"
  },
  "a2-3-1": {
    "text": "Let's meet on Saturday.",
    "sparky": "/audio/mascots/8e3664a37c41fb239fa5d9b81de84e6e.wav",
    "pinky": "/audio/mascots/6383613e4f2b92221220dbd9ea91a01a.wav"
  },
  "a2-planos-01": {
    "text": "We are going to visit our cousins.",
    "sparky": "/audio/mascots/2dae07a85b20e7cd61f1338d410dd64a.wav",
    "pinky": "/audio/mascots/0cde00d8aeb77ba48525c77be1542045.wav"
  },
  "a2-planos-02": {
    "text": "I will help you with those bags.",
    "sparky": "/audio/mascots/46f73796764463ffc6ec47403cace88a.wav",
    "pinky": "/audio/mascots/c0bc6c21bac5065e524ef7f7d113bcf9.wav"
  },
  "a2-planos-03": {
    "text": "I am meeting my tutor on Thursday.",
    "sparky": "/audio/mascots/ff497c36004e8b28765f33b675199415.wav",
    "pinky": "/audio/mascots/d25e0b04e578779935bd0f30e470d65f.wav"
  },
  "a2-planos-04": {
    "text": "Would you like to join us for dinner?",
    "sparky": "/audio/mascots/8e7af0e18da7358986e09f8b83a125cd.wav",
    "pinky": "/audio/mascots/188cbb4fde0016f7314c11d7fe86e43c.wav"
  },
  "a2-planos-05": {
    "text": "If it rains, we will stay at home.",
    "sparky": "/audio/mascots/c7adc1c6e4b551b85bfa5782376188be.wav",
    "pinky": "/audio/mascots/1a8b2eac3e00e80f0aa7c14c436a1a4b.wav"
  },
  "a2-planos-06": {
    "text": "When I finish work late, I take a taxi.",
    "sparky": "/audio/mascots/3a82f90e89b6171163127edc32f36ce2.wav",
    "pinky": "/audio/mascots/94571bfc320cf1bb2469ded88f363fbd.wav"
  },
  "a2-servicos-01": {
    "text": "You should check the timetable first.",
    "sparky": "/audio/mascots/3ac1c2d62a9913f7d0a6f30713efc1f0.wav",
    "pinky": "/audio/mascots/ae95ee3398ef06b52d18b3dde0552da8.wav"
  },
  "a2-servicos-02": {
    "text": "We have to show our tickets.",
    "sparky": "/audio/mascots/f0e9be0f9df5685fa39b353bd9b441f0.wav",
    "pinky": "/audio/mascots/063c1e4c2356156c229b2db5d01d019c.wav"
  },
  "a2-servicos-03": {
    "text": "You must not park in front of the gate.",
    "sparky": "/audio/mascots/885712ab266603797eb72f5ab939b1e3.wav",
    "pinky": "/audio/mascots/fa15b4ba58ed9dc1811a6d4bae3a17e0.wav"
  },
  "a2-servicos-04": {
    "text": "I would like to book a room for two nights.",
    "pinky": "/audio/mascots/2ef317ba0152a1c27f113843e7b40483.wav",
    "sparky": "/audio/mascots/1f4258ae369a442168065b0470d4e830.wav"
  },
  "a2-servicos-05": {
    "text": "These headphones do not work.",
    "sparky": "/audio/mascots/a564135a464c4e120366db0c40ac0f80.wav",
    "pinky": "/audio/mascots/cc7d1a48534ca59860929db4901d15af.wav"
  },
  "a2-servicos-06": {
    "text": "Could we reschedule my appointment?",
    "sparky": "/audio/mascots/2a79df29de726f04468f506fa2df0e64.wav",
    "pinky": "/audio/mascots/6275d24db298f324ba7ec2d5a0638864.wav"
  },
  "a2-textos-01": {
    "text": "Please send them the address.",
    "pinky": "/audio/mascots/1604ff412ed2d43d9855a1c34c8207e5.wav",
    "sparky": "/audio/mascots/58109bd51b416010f335c89b149528bb.wav"
  },
  "a2-textos-02": {
    "text": "The shop was closed, so we went home.",
    "sparky": "/audio/mascots/85bc987eb59a8673b07824052f7417c5.wav",
    "pinky": "/audio/mascots/02d93ca81d3668ad60b9623e8a05721d.wav"
  },
  "a2-textos-03": {
    "text": "Please arrive fifteen minutes before the tour.",
    "sparky": "/audio/mascots/7611fc72753ccd5c843564c867296382.wav",
    "pinky": "/audio/mascots/ed145aa841fbabdd5296f0b964e407e1.wav"
  },
  "a2-textos-04": {
    "text": "The room was clean, but the street was noisy.",
    "pinky": "/audio/mascots/cb21554ba99075fdcde4c3a0226dbc3c.wav",
    "sparky": "/audio/mascots/2f480a920c5239e67e5f9a68dcfc9b5e.wav"
  },
  "a2-textos-05": {
    "text": "Could you send me the course timetable?",
    "sparky": "/audio/mascots/a47291a52f2ff34f85b244fc91306825.wav",
    "pinky": "/audio/mascots/4b7b11837bbd2b2b90ef89168ed59fe4.wav"
  },
  "a2-textos-06": {
    "text": "You can enter after six with your ticket.",
    "sparky": "/audio/mascots/2fff0674834d832d695871f8e1530e43.wav",
    "pinky": "/audio/mascots/b0c54a2aec369b8f1b62abc0cb2b969b.wav"
  },
  "a2-comunicacao-01": {
    "text": "Could you tell me how to get to the library?",
    "sparky": "/audio/mascots/c8926610917b569e991cf0f542091118.wav",
    "pinky": "/audio/mascots/c6d2eec0a9f43ddc19d7961ed9284fb4.wav"
  },
  "a2-comunicacao-02": {
    "text": "Does this bus go to Central Station?",
    "sparky": "/audio/mascots/652e9731b722fff8ec7598397a922b00.wav",
    "pinky": "/audio/mascots/590a55763cf21fe86d7d9569bbf65a95.wav"
  },
  "a2-comunicacao-03": {
    "text": "Could I have the soup without cheese, please?",
    "pinky": "/audio/mascots/78268c414e146808732c47e44485a29e.wav",
    "sparky": "/audio/mascots/f89dc322f1f9466f3baf7d6877bc9420.wav"
  },
  "a2-comunicacao-04": {
    "text": "Could you say that more slowly, please?",
    "sparky": "/audio/mascots/43ce58c4afc2baa29dacc83648d22e44.wav",
    "pinky": "/audio/mascots/342bbc23211cf8f42f20834e6a0b252f.wav"
  },
  "a2-comunicacao-05": {
    "text": "Would you mind closing the window?",
    "pinky": "/audio/mascots/ea16e5a96aa7269ff1248bd2b1aa7cdd.wav",
    "sparky": "/audio/mascots/f6d9503c310ee80dccbcba93d0dd1364.wav"
  },
  "a2-comunicacao-06": {
    "text": "I'm running late, so could we meet at six thirty instead?",
    "sparky": "/audio/mascots/0c59453e9761787405eed203d0b48ee8.wav",
    "pinky": "/audio/mascots/65657fbe672b40bbf9d9d76c279d1d44.wav"
  },
  "b1-narrativas-01": {
    "text": "I used to walk to school every day.",
    "sparky": "/audio/mascots/a14e845c5c6deb7477713c1359be7f2f.wav",
    "pinky": "/audio/mascots/23b8c8f00084e1f2e7eac3cdc82236e7.wav"
  },
  "b1-narrativas-02": {
    "text": "The film had started before we arrived.",
    "sparky": "/audio/mascots/b04b5a073aa9c14aaf1c9364edd641ca.wav",
    "pinky": "/audio/mascots/4360ecc9d7a923b854313938f42bc9f0.wav"
  },
  "b1-narrativas-03": {
    "text": "While I was walking home, I noticed a wallet.",
    "sparky": "/audio/mascots/7cd58a105fda8725ba72fa21be508ec0.wav",
    "pinky": "/audio/mascots/cf6fd0298a105301324af1ac331c5220.wav"
  },
  "b1-narrativas-04": {
    "text": "I have been studying for two hours.",
    "sparky": "/audio/mascots/aeda27f76d568a0d33683f58b7fd7526.wav",
    "pinky": "/audio/mascots/63b1b0f32bd1ab5dbd1419773682725d.wav"
  },
  "b1-narrativas-05": {
    "text": "She said she was tired.",
    "sparky": "/audio/mascots/d67ef6e041ab6daad06c4747f65f8c13.wav",
    "pinky": "/audio/mascots/5565a1bc97e17f4805b9a5ba6d6f573c.wav"
  },
  "b1-narrativas-06": {
    "text": "We managed to catch the last train.",
    "sparky": "/audio/mascots/ff9c65cd19fefad6c48188a90c367049.wav",
    "pinky": "/audio/mascots/ca632f29e996fb7e5aafd103e13ec5ba.wav"
  },
  "b1-5-1": {
    "text": "I think this plan is better.",
    "sparky": "/audio/mascots/c453f57c2ff96574f4b6c4521cb53043.wav",
    "pinky": "/audio/mascots/c6964ef76e24ed782f7dc85b77cae88c.wav"
  },
  "b1-argumentos-01": {
    "text": "I see your point, but the cost is high.",
    "sparky": "/audio/mascots/b9c5587159c7c406adda444ecfe174d8.wav",
    "pinky": "/audio/mascots/c8a782c9ad5e9bab72b7913b2bb42cf3.wav"
  },
  "b1-argumentos-02": {
    "text": "Although it was expensive, we chose the train.",
    "sparky": "/audio/mascots/a0244ec444b6b33a740625213f37b0db.wav",
    "pinky": "/audio/mascots/4c7a2604b9b3b496681b99b6cf41de39.wav"
  },
  "b1-argumentos-03": {
    "text": "I enjoy outdoor activities such as hiking.",
    "pinky": "/audio/mascots/ab6fde54601b7231fcf62b486860c160.wav",
    "sparky": "/audio/mascots/9d0a8e9152ab1a248554d8a4e777386c.wav"
  },
  "b1-argumentos-04": {
    "text": "One advantage of cycling is the low cost.",
    "sparky": "/audio/mascots/e6b582ff8acba9ef14ce849bd7c2593e.wav",
    "pinky": "/audio/mascots/0d954d28676e63f5ceac86a4f1300044.wav"
  },
  "b1-argumentos-05": {
    "text": "I recommend booking your tickets early.",
    "sparky": "/audio/mascots/95764a7dcc94f754dc8d1fdd65e077bf.wav",
    "pinky": "/audio/mascots/93ecf089cd1488102a91e46c73436707.wav"
  },
  "b1-argumentos-06": {
    "text": "According to the timetable, the train leaves at nine.",
    "sparky": "/audio/mascots/569fc6d40f3c995161777b0bc9c349e8.wav",
    "pinky": "/audio/mascots/825e6cf55c775c15320c6a62c715c466.wav"
  },
  "b1-hipoteses-01": {
    "text": "We might change the date of the meeting.",
    "sparky": "/audio/mascots/a318388587108909b380a12d54ff4ee1.wav",
    "pinky": "/audio/mascots/1e01f40f9f84eb6512e5a7ae9d3e4eaa.wav"
  },
  "b1-hipoteses-02": {
    "text": "He must be tired after that long journey.",
    "sparky": "/audio/mascots/7b432d2a2abfeb429ea0b0849fea5400.wav",
    "pinky": "/audio/mascots/5ce4d016194b9e6a7e22b2db54d79ab9.wav"
  },
  "b1-hipoteses-03": {
    "text": "If I had more time, I would learn Italian.",
    "sparky": "/audio/mascots/83b42d900210801be2654b6f742e4c63.wav",
    "pinky": "/audio/mascots/fcfb075f6f33a49910391c6db70be4a0.wav"
  },
  "b1-hipoteses-04": {
    "text": "If I finish early, I will call you.",
    "sparky": "/audio/mascots/1bb5f2038cf650034a161e2a59c44033.wav",
    "pinky": "/audio/mascots/f8d0b5c3b446c51539d119b80decfb5b.wav"
  },
  "b1-hipoteses-05": {
    "text": "We will miss the bus unless we leave now.",
    "sparky": "/audio/mascots/4ad84707773c489efd75e57c913eb9f1.wav",
    "pinky": "/audio/mascots/be6afe6e5fc11a2067dfddfb4306d74e.wav"
  },
  "b1-hipoteses-06": {
    "text": "I would rather walk than wait for a taxi.",
    "sparky": "/audio/mascots/7501a5602bde67954ee5747dc086c295.wav",
    "pinky": "/audio/mascots/9cfe1ce1d3bed533b3a53f2b12c48e06.wav"
  },
  "b1-precisao-01": {
    "text": "She is the colleague who helped me yesterday.",
    "sparky": "/audio/mascots/192dd2d58dd5f5dc82698b4525a348df.wav",
    "pinky": "/audio/mascots/7d32394e6ec657379c525714dcc75f1e.wav"
  },
  "b1-precisao-02": {
    "text": "The library is cleaned every morning.",
    "sparky": "/audio/mascots/b9ef37515c02b9c0e20a5c2e64e9e886.wav",
    "pinky": "/audio/mascots/f62f6d549345c7ba98aaad20e7c1d197.wav"
  },
  "b1-precisao-03": {
    "text": "The bridge was opened last year.",
    "sparky": "/audio/mascots/43bb3c45f63055231e62f392f12fb253.wav",
    "pinky": "/audio/mascots/f14bb21f653518682b5849362029c6cb.wav"
  },
  "b1-precisao-04": {
    "text": "We decided to leave before lunch.",
    "sparky": "/audio/mascots/bffd0c3c7ddde89c26266fde72d7d53c.wav",
    "pinky": "/audio/mascots/ac3c7f40227d26b0c63ed0df6a7f6bd7.wav"
  },
  "b1-precisao-05": {
    "text": "Please turn it off before you leave.",
    "sparky": "/audio/mascots/3cc123fa7b3b7866f2731e81fabe148a.wav",
    "pinky": "/audio/mascots/341576194a01f5a21d56c39a6bad9a79.wav"
  },
  "b1-precisao-06": {
    "text": "She is interested in learning photography.",
    "sparky": "/audio/mascots/cc531bca730825d6914b4ce1d29a4d97.wav",
    "pinky": "/audio/mascots/7c1b08bb402d89dacad576b62881c2f1.wav"
  },
  "b1-6-1": {
    "text": "Could you explain that again?",
    "sparky": "/audio/mascots/49dc28808779a2011aac90e76a418039.wav",
    "pinky": "/audio/mascots/33a68e893790cffc81795de58d6fa2d0.wav"
  },
  "b1-colaboracao-01": {
    "text": "Could you tell me where the office is?",
    "sparky": "/audio/mascots/9e73f684a561e3f6b847ae1db057224c.wav",
    "pinky": "/audio/mascots/cd0b728432fbca7a27361c857b01536c.wav"
  },
  "b1-colaboracao-02": {
    "text": "So, you mean the deadline is Friday?",
    "sparky": "/audio/mascots/114b3c52cdc8c2ad5e56ec5925d49fb2.wav",
    "pinky": "/audio/mascots/826a902d8d61e2dff449afa7f7c86daa.wav"
  },
  "b1-colaboracao-03": {
    "text": "Could we extend the deadline until Friday?",
    "sparky": "/audio/mascots/143aeac8e8ec9515bbce218aa08056c1.wav",
    "pinky": "/audio/mascots/7e77ae240faaad9134e3b1fa6246a3df.wav"
  },
  "b1-colaboracao-04": {
    "text": "Could you show me how to upload this file?",
    "pinky": "/audio/mascots/5b7662d938d62d473b18a42437e09722.wav",
    "sparky": "/audio/mascots/6f63488cce3bb97061550f91ae7418ea.wav"
  },
  "b1-colaboracao-05": {
    "text": "I ordered a blue bag, but I received a green one.",
    "sparky": "/audio/mascots/894333d19042e77a0ab2cf53633eb5b3.wav",
    "pinky": "/audio/mascots/1a03d9e9d32cf6a97990458cab515f5e.wav"
  },
  "b1-colaboracao-06": {
    "text": "We agreed to send the proposal by Tuesday.",
    "sparky": "/audio/mascots/e42292066a4ee98336b0bd181b822497.wav",
    "pinky": "/audio/mascots/b53455288d19b47f1c9dcef41f6bae81.wav"
  },
  "b1-leitura-01": {
    "text": "The article explains why the club changed its schedule.",
    "sparky": "/audio/mascots/744baa24fa5f04d76fb86e302a114f68.wav",
    "pinky": "/audio/mascots/8bb7772c1cdf5de2d5baa819b82909d8.wav"
  },
  "b1-leitura-02": {
    "text": "She seems worried about the deadline.",
    "pinky": "/audio/mascots/ac24713911f0643d0fa377b91d31623f.wav",
    "sparky": "/audio/mascots/6b057a3e7f4358fe10fe6925aabbcfc1.wav"
  },
  "b1-leitura-03": {
    "text": "The latest notice gives a different opening time.",
    "sparky": "/audio/mascots/9d8aa6965a6cf497c0ac604db73046ca.wav",
    "pinky": "/audio/mascots/fba24fd26641c1889bf3d46dd2e77790.wav"
  },
  "b1-leitura-04": {
    "text": "I am writing to ask about your evening course.",
    "sparky": "/audio/mascots/c00176425c7a792e29db3a5344fe5eb3.wav",
    "pinky": "/audio/mascots/95167d97a0a92e4c58b6f07fa3754390.wav"
  },
  "b1-leitura-05": {
    "text": "Regular practice helps because it builds familiarity.",
    "pinky": "/audio/mascots/513001042a46cbad528484c39e5696f2.wav",
    "sparky": "/audio/mascots/195f167405494d32980677f6d8cb14cc.wav"
  },
  "b1-leitura-06": {
    "text": "We chose the library because it is quiet and free.",
    "pinky": "/audio/mascots/20bbb9f242466a75d886fae2594ae870.wav",
    "sparky": "/audio/mascots/ba62436ec17fb5a7b3b6a242c26537b6.wav"
  },
  "b2-argumentacao-01": {
    "text": "Although the trial was short, it provided useful evidence.",
    "sparky": "/audio/mascots/f70554c37228b56f72bc67e419470af7.wav",
    "pinky": "/audio/mascots/bf65f7b5d8f544248f34a0d5e0a038bf.wav"
  },
  "b2-argumentacao-02": {
    "text": "The new schedule may have contributed to the improvement.",
    "sparky": "/audio/mascots/52606023ac2d09f5e5b468ed655fae35.wav",
    "pinky": "/audio/mascots/7408f4fe3b49db85e07fae4f485971e2.wav"
  },
  "b2-argumentacao-03": {
    "text": "I see your point, but we need a more reliable estimate.",
    "pinky": "/audio/mascots/abb64f72801d566b51e2ebb366f08c46.wav",
    "sparky": "/audio/mascots/b8484e6c8c9bc152c867d90dc34c9cf4.wav"
  },
  "b2-argumentacao-04": {
    "text": "The first option is cheaper, whereas the second is easier to maintain.",
    "sparky": "/audio/mascots/4c4d1966ddebc60e679b1e5d2407d9ff.wav",
    "pinky": "/audio/mascots/73540a3aea254060b3e6fa206d3490b0.wav"
  },
  "b2-argumentacao-05": {
    "text": "We can extend the deadline provided that the scope stays the same.",
    "pinky": "/audio/mascots/e8cabd538b6e29b79501f8337e87c475.wav",
    "sparky": "/audio/mascots/52ccd5d1225b3373a346b9e3dbca0227.wav"
  },
  "b2-argumentacao-06": {
    "text": "This concern could be addressed by offering an offline option.",
    "sparky": "/audio/mascots/56dca4417ef229aad54d0a7f26097055.wav",
    "pinky": "/audio/mascots/23b76cce0fdb87b8de4ca2229251746a.wav"
  },
  "b2-autonomia-01": {
    "text": "They agreed to review the proposal before making a decision.",
    "sparky": "/audio/mascots/422a627e2beb02f142fb05c5305cb41a.wav",
    "pinky": "/audio/mascots/4d557d553a9692e91a01e63f2f7e79ea.wav"
  },
  "b2-autonomia-02": {
    "text": "In other words, the discount applies only to annual subscriptions.",
    "pinky": "/audio/mascots/943a1491f2f2e064b583a21c0fa820dc.wav",
    "sparky": "/audio/mascots/a0daa67148ce1f9a97020e0f3bf43949.wav"
  },
  "b2-autonomia-03": {
    "text": "The replacement was supposed to arrive last week.",
    "sparky": "/audio/mascots/d8022cc5f98ba30166a4ada219717516.wav",
    "pinky": "/audio/mascots/3d260975350aaa535d67ba0f054617cc.wav"
  },
  "b2-autonomia-04": {
    "text": "Turning to the survey results, most respondents preferred evening classes.",
    "sparky": "/audio/mascots/23ebfb15b8641b4d53c49da03484a6df.wav",
    "pinky": "/audio/mascots/e106db47c0722da733bf0ba9c1eab54d.wav"
  },
  "b2-autonomia-05": {
    "text": "If we had checked the file, we would have noticed the missing page.",
    "sparky": "/audio/mascots/4b5c03afdfdc06399592ac6ba5d5ff3f.wav",
    "pinky": "/audio/mascots/4a69ff9f10ad3eb4f04dcdf3a75d6eb5.wav"
  },
  "b2-autonomia-06": {
    "text": "We recommend a trial before committing to a permanent change.",
    "sparky": "/audio/mascots/51de26626e669b24cd0ffc1c47d859d4.wav",
    "pinky": "/audio/mascots/442fc69047b6e509202ed645b3acac3b.wav"
  },
  "c1-sintese-01": {
    "text": "Both reports suggest that access matters, although they measure different outcomes.",
    "pinky": "/audio/mascots/4ecc85cd4d89d7b3d7e8bdaa82e53edc.wav",
    "sparky": "/audio/mascots/30e620a66e61b7d1f984a7b283771bb7.wav"
  },
  "c1-sintese-02": {
    "text": "The decline appears to reflect a change in reporting rather than demand.",
    "sparky": "/audio/mascots/2163c3d24c3e08eb002c85ee7d8bb4a9.wav",
    "pinky": "/audio/mascots/b27324c29734b2bd33bd584b24c9e345.wav"
  },
  "c1-sintese-03": {
    "text": "This discrepancy prompted the team to examine how the figures were collected.",
    "sparky": "/audio/mascots/752730053debe99e9f33cbd3fb0315ed.wav",
    "pinky": "/audio/mascots/dad853e2571faaf290530b89ca2f5fa1.wav"
  },
  "c1-sintese-04": {
    "text": "The authors caution that the findings may not apply to smaller organisations.",
    "sparky": "/audio/mascots/99d42c79465d421e69c1809061bc6f5e.wav",
    "pinky": "/audio/mascots/92df23d8f1fb34ed3865da31c83ac7d6.wav"
  },
  "c1-sintese-05": {
    "text": "The exception suggests that the claim needs to be narrowed.",
    "sparky": "/audio/mascots/efee323c4e54b702f1500edd3599ecb9.wav",
    "pinky": "/audio/mascots/2cc42630dce6c4aa3be22c5f9030a5a7.wav"
  },
  "c1-sintese-06": {
    "text": "On balance, a phased introduction would allow the policy to be evaluated.",
    "sparky": "/audio/mascots/507f1d2375b3f7e952aeb9ee8a991afe.wav",
    "pinky": "/audio/mascots/a77f049a2cae5a3d6869c163463ea251.wav"
  },
  "c1-interacao-01": {
    "text": "We would appreciate receiving your comments by Thursday.",
    "sparky": "/audio/mascots/0c68701c7e1368abf132b15b5720799c.wav",
    "pinky": "/audio/mascots/fbedd22896b4081a4795eea4a9392093.wav"
  },
  "c1-interacao-02": {
    "text": "What both teams need is a predictable process for handling urgent requests.",
    "pinky": "/audio/mascots/9c605f08bd6dea4c897de0239897d15a.wav",
    "sparky": "/audio/mascots/478fc982b5af72caa83bc9d176e508c9.wav"
  },
  "c1-interacao-03": {
    "text": "Is there any chance we could revisit the final paragraph?",
    "sparky": "/audio/mascots/8d4f17e24e3ac3b3c1aa3123aa9b0ebe.wav",
    "pinky": "/audio/mascots/c0846418848528e8de481ad61b8bc38b.wav"
  },
  "c1-interacao-04": {
    "text": "Only after the review did we understand the scale of the problem.",
    "sparky": "/audio/mascots/1ce8933faaa85e8cac1a78d67ba6ab88.wav",
    "pinky": "/audio/mascots/088e4f87b3dd8afb74065e6a695da07d.wav"
  },
  "c1-interacao-05": {
    "text": "Let me distinguish between the initial estimate and the approved budget.",
    "sparky": "/audio/mascots/17cf1042997a3acc1dc46c6ccbc959c9.wav",
    "pinky": "/audio/mascots/52a2a43fdd5568289480465081adde96.wav"
  },
  "c1-interacao-06": {
    "text": "The agreement remains subject to a successful accessibility review.",
    "sparky": "/audio/mascots/cd097dcf1fb57c060ef6434bfe9f442e.wav",
    "pinky": "/audio/mascots/34963511ffadf6f405f615ccccfb0680.wav"
  },
  "c2-nuance-01": {
    "text": "To grant that the scheme is efficient is not to endorse its underlying assumptions.",
    "pinky": "/audio/mascots/4322498f79aa91092b11a94875d80b2a.wav",
    "sparky": "/audio/mascots/0e5d14042172ea09ea48563577cfd6bd.wav"
  },
  "c2-nuance-02": {
    "text": "Calling the delay a triumph of efficiency was hardly an unqualified compliment.",
    "sparky": "/audio/mascots/ef81560f1916d35fefb7037bf66a10ef.wav",
    "pinky": "/audio/mascots/885f744e53cead59ba6b4ce10bfd49ae.wav"
  },
  "c2-nuance-03": {
    "text": "The question presupposes a failure that the report has not established.",
    "sparky": "/audio/mascots/7bf8376d1c74e296b4c8c2edda26f69b.wav",
    "pinky": "/audio/mascots/53c6a14427e6f3a01ea72e2ea78eab6f.wav"
  },
  "c2-nuance-04": {
    "text": "Not all applicants were excluded, but the criteria remained unclear.",
    "sparky": "/audio/mascots/2549e1b75ec790658d34cdfbac0cacc2.wav",
    "pinky": "/audio/mascots/c7ed9b6ab54862bc5d844dfbb5951b8b.wav"
  },
  "c2-nuance-05": {
    "text": "The metaphor foregrounds speed while obscuring the need for ongoing support.",
    "sparky": "/audio/mascots/e43ffef002eafcb833614be741418b52.wav",
    "pinky": "/audio/mascots/01947c87abd5650cfc7f1c0608e8f33e.wav"
  },
  "c2-nuance-06": {
    "text": "The passage permits two readings, but the final qualification favours the narrower one.",
    "sparky": "/audio/mascots/5a076a7d6626c76ef3b7393dd36a3cc2.wav",
    "pinky": "/audio/mascots/038fec5077b3ecd2077648fafe503799.wav"
  },
  "c2-producao-01": {
    "text": "The revision removes repetition without sacrificing the argument's qualifications.",
    "sparky": "/audio/mascots/b5caf9bb3c55de3acfa357e47bdf5f29.wav",
    "pinky": "/audio/mascots/819973bcb8c797c8fc28caeac27dbfa9.wav"
  },
  "c2-producao-02": {
    "text": "A simpler explanation need not imply a less accurate one.",
    "sparky": "/audio/mascots/fbb62c109bc509e3f4be6241ad79e236.wav",
    "pinky": "/audio/mascots/972004c250a06065878a0be8769443cf.wav"
  },
  "c2-producao-03": {
    "text": "The report attributes the criticism to residents without adopting every allegation.",
    "sparky": "/audio/mascots/289ebb1ecfcace6038f3007df4a3d40f.wav",
    "pinky": "/audio/mascots/7d18ab4d8d3cdb644b1bfeda6dde00a5.wav"
  },
  "c2-producao-04": {
    "text": "The objection is well founded, but it does not by itself settle the question.",
    "sparky": "/audio/mascots/b6ccb986c659ba944497c1c3302e1179.wav",
    "pinky": "/audio/mascots/c1b1d278cc39d6d13ea5869830e93a6f.wav"
  },
  "c2-producao-05": {
    "text": "Describing the improvement as merely adequate introduces a judgement beyond the figures.",
    "sparky": "/audio/mascots/c1f0b05415062b3012f5a40bbc5dcd50.wav",
    "pinky": "/audio/mascots/791c2e0c2398f864d0fecf1f4ceb0d9d.wav"
  },
  "c2-producao-06": {
    "text": "A defensible conclusion must accommodate uncertainty without surrendering judgement.",
    "sparky": "/audio/mascots/e0295ed3bfa8869c448fcbaaa94bfc51.wav",
    "pinky": "/audio/mascots/60f95dfd19d50336fa4066ee1eaaab6f.wav"
  },
  "c1-evidencias-01": {
    "text": "The study is relevant, but its narrow sample limits the reach of its conclusions.",
    "sparky": "/audio/mascots/71867cfaba7ec3f7365aa8cb4718ba83.wav",
    "pinky": "/audio/mascots/fa0d46ea2a3ff48d6b39537327ff691b.wav"
  },
  "c1-evidencias-02": {
    "text": "The figures suggest a short-term shift rather than a permanent change in behaviour.",
    "sparky": "/audio/mascots/7f1ee7eafe671affe6152671a3c97b4c.wav",
    "pinky": "/audio/mascots/6b0108821a02187080fc20b8c8ee2fd0.wav"
  },
  "c1-evidencias-03": {
    "text": "The estimate is sufficiently precise for planning, though not for ranking small differences.",
    "sparky": "/audio/mascots/3638fa467b5f121d467a2bd6eb51f1dc.wav",
    "pinky": "/audio/mascots/b6fa59cf64710904016a7106d71ec1aa.wav"
  },
  "c1-evidencias-04": {
    "text": "The rate doubled, but the increase represented only four additional cases.",
    "sparky": "/audio/mascots/563a199b126d6e9264a80fa99821e515.wav",
    "pinky": "/audio/mascots/f71597788984301809d1dbe5b67ae260.wav"
  },
  "c1-evidencias-05": {
    "text": "The verified record shows a schedule change, not the cancellation described online.",
    "sparky": "/audio/mascots/cee9cb2414ed88c0082bf511b2bae926.wav",
    "pinky": "/audio/mascots/fb1dd55c2c198a40fdb46dbbb298e653.wav"
  },
  "c1-evidencias-06": {
    "text": "On balance, a limited pilot is justified, provided that access and outcomes are independently reviewed.",
    "sparky": "/audio/mascots/eef62e7640731a481227a71d55c69a0a.wav",
    "pinky": "/audio/mascots/63c9a746ed8aaea11c014d8be0398cdd.wav"
  },
  "c2-estilo-cultura-01": {
    "text": "The headline echoes a familiar promise only to expose how little has changed.",
    "sparky": "/audio/mascots/d824eb691ee2378c4266aa22b592920e.wav",
    "pinky": "/audio/mascots/e5a8863fb01279c00cdf5b8949c5138b.wav"
  },
  "c2-estilo-cultura-02": {
    "text": "The narrator reproduces the committee's certainty without necessarily sharing it.",
    "pinky": "/audio/mascots/bceedb7f83dbd7af30e7d490a6c71f9d.wav",
    "sparky": "/audio/mascots/4256796c9684328a5457ef4f12cb6a7d.wav"
  },
  "c2-estilo-cultura-03": {
    "text": "A literal translation preserved the words but misplaced the joke's target.",
    "sparky": "/audio/mascots/1a2b097bd71f84128079cebe662d2eff.wav",
    "pinky": "/audio/mascots/c2288f2ae416c90b2a62354962c9a91c.wav"
  },
  "c2-estilo-cultura-04": {
    "text": "The two accounts describe the same transfer while assigning agency and benefit differently.",
    "sparky": "/audio/mascots/5b53c137df6e259e79e2e9dfc3623533.wav",
    "pinky": "/audio/mascots/e9dde7ad7975af7562009f218c0fd457.wav"
  },
  "c2-estilo-cultura-05": {
    "text": "The revision clarifies the sequence, balances the clauses and reserves the final stress for the consequence.",
    "sparky": "/audio/mascots/a4e665ae920da5a24ead6ecd25c4e0e5.wav",
    "pinky": "/audio/mascots/7199afb8b71fd280c8c192682233c144.wav"
  },
  "c2-estilo-cultura-06": {
    "text": "The comparison is illuminating precisely where the texts pursue similar ends through incompatible rhetorical means.",
    "sparky": "/audio/mascots/635909336fe988a12a0fdad14bf0930d.wav",
    "pinky": "/audio/mascots/30a648b305d0a214228f2d0f1231e4e1.wav"
  },
  "b1-vida-em-movimento-01": {
    "text": "I'm going to be late, so I'll meet you at the entrance.",
    "sparky": "/audio/mascots/e7f388cc608bb8ec195e042c56544570.wav",
    "pinky": "/audio/mascots/06055f3fc1d82e0251f1bac4f4ac041b.wav"
  },
  "b1-vida-em-movimento-02": {
    "text": "It keeps switching off, even when the battery is full.",
    "sparky": "/audio/mascots/251cc1a445fe458be46a00160613e8ec.wav",
    "pinky": "/audio/mascots/38ef820f70f7791c62d32121f13700f0.wav"
  },
  "b2-acordos-cotidianos-01": {
    "text": "Let's try the new schedule for two weeks and then discuss how it went.",
    "pinky": "/audio/mascots/5a35f9ace01e5f3986b6d7dbb3f94963.wav",
    "sparky": "/audio/mascots/cb41d53caa9ac3c259653db88920d255.wav"
  },
  "b2-acordos-cotidianos-02": {
    "text": "The museum sounds promising, as long as we can confirm the access.",
    "sparky": "/audio/mascots/cb074ed3b44e1e29dd5165d98dd818bd.wav",
    "pinky": "/audio/mascots/bbf5acce3294dca068e654cb8ea80924.wav"
  },
  "c1-intencoes-e-impacto-01": {
    "text": "If you're asking me to take this on, we'd need to revisit the deadline.",
    "sparky": "/audio/mascots/12a4ac2efd1036653f0e5961332b7f40.wav",
    "pinky": "/audio/mascots/68f81fc10023b4d9723961ae7dd664ce.wav"
  },
  "c1-intencoes-e-impacto-02": {
    "text": "Would it help if I led with the finding and explained the caveat afterwards?",
    "sparky": "/audio/mascots/2231e5953e99687c7a1c5a6cad5cf4bb.wav",
    "pinky": "/audio/mascots/9d2453ed02af796acd2ce490c3bcb608.wav"
  },
  "c2-significado-em-disputa-01": {
    "text": "That question assumes the decision was final, which is precisely what's disputed.",
    "sparky": "/audio/mascots/af613eb475b19eaac098502bec198a4b.wav",
    "pinky": "/audio/mascots/a35bb8b1245482338689d3104bc5cbdc.wav"
  },
  "c2-significado-em-disputa-02": {
    "text": "Calling the delay a triumph of efficiency was hardly an unqualified compliment.",
    "sparky": "/audio/mascots/ef81560f1916d35fefb7037bf66a10ef.wav",
    "pinky": "/audio/mascots/885f744e53cead59ba6b4ce10bfd49ae.wav"
  }
}
